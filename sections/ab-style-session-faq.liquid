{%- assign faq_blocks = section.blocks | where: 'type', 'faq' -%}
<section class="ab-section ab-faq color-{{ section.settings.color_scheme }}">
  <div class="page-width ab-faq__layout">
    <div class="ab-section__intro">
      {%- if section.settings.eyebrow != blank -%}<p class="ab-eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
      {%- if section.settings.heading != blank -%}<h2 class="ab-section__heading">{{ section.settings.heading | escape }}</h2>{%- endif -%}
      {%- if section.settings.intro != blank -%}<div class="rte">{{ section.settings.intro }}</div>{%- endif -%}
    </div>
    {%- if faq_blocks.size > 0 -%}
      <div class="ab-faq__list">
        {%- for block in faq_blocks -%}
          <details class="ab-faq__item" {{ block.shopify_attributes }}>
            <summary>{{ block.settings.question | escape }}<span aria-hidden="true"></span></summary>
            <div class="ab-faq__answer rte">{{ block.settings.answer }}</div>
          </details>
        {%- endfor -%}
      </div>
      <script type="application/ld+json">
        {
          "@context":"https://schema.org",
          "@type":"FAQPage",
          "mainEntity":[
            {%- for block in faq_blocks -%}
              {"@type":"Question","name":{{ block.settings.question | strip_html | json }},"acceptedAnswer":{"@type":"Answer","text":{{ block.settings.answer | strip_html | json }}}}{% unless forloop.last %},{% endunless %}
            {%- endfor -%}
          ]
        }
      </script>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name":"FAQ",
  "tag":"section",
  "class":"section-ab-faq",
  "settings":[
    {"type":"text","id":"eyebrow","label":"Eyebrow","default":"GOOD TO KNOW"},
    {"type":"text","id":"heading","label":"Heading","default":"Questions, answered"},
    {"type":"richtext","id":"intro","label":"Intro","default":"<p>Find out what to expect from your style session.</p>"},
    {"type":"color_scheme","id":"color_scheme","label":"Color scheme","default":"scheme-1"}
  ],
  "blocks":[{"type":"faq","name":"Question and answer","settings":[
    {"type":"text","id":"question","label":"Question","default":"What happens in a style session?"},
    {"type":"richtext","id":"answer","label":"Answer","default":"<p>Your stylist learns about your occasion and preferences, then helps you explore a made-to-order look.</p>"}
  ]}],
  "max_blocks":12,
  "presets":[{"name":"FAQ","blocks":[{"type":"faq"},{"type":"faq","settings":{"question":"How long does a consultation take?","answer":"<p>Your team can add the expected session length here.</p>"}}]}
  ]
}
{% endschema %}
