<section id="style-session-booking" class="ab-section ab-booking color-{{ section.settings.color_scheme }}">
  <div class="page-width">
    <div class="ab-booking__intro ab-section__intro">
      {%- if section.settings.eyebrow != blank -%}<p class="ab-eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
      {%- if section.settings.heading != blank -%}<h2 class="ab-section__heading">{{ section.settings.heading | escape }}</h2>{%- endif -%}
      {%- if section.settings.intro != blank -%}<div class="rte">{{ section.settings.intro }}</div>{%- endif -%}
    </div>
    {%- if section.settings.calendly_url != blank -%}
      <div class="ab-booking__frame">
        <iframe
          data-attribution-calendly
          data-calendly-url="{{ section.settings.calendly_url | escape }}"
          title="{{ section.settings.iframe_title | escape }}"
          loading="lazy"
          referrerpolicy="strict-origin-when-cross-origin"
          allow="payment"
        ></iframe>
      </div>
    {%- else -%}
      <div class="ab-editor-note">{{ section.settings.setup_note | escape }}</div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name":"Style session booking",
  "tag":"section",
  "class":"section-ab-booking",
  "settings":[
    {"type":"text","id":"eyebrow","label":"Eyebrow","default":"LET’S BEGIN"},
    {"type":"text","id":"heading","label":"Heading","default":"Book your style session"},
    {"type":"richtext","id":"intro","label":"Intro","default":"<p>Choose a time to speak with a stylist about your next occasion.</p>"},
    {"type":"url","id":"calendly_url","label":"Calendly booking URL"},
    {"type":"text","id":"iframe_title","label":"Embed accessibility title","default":"Book a style session"},
    {"type":"text","id":"setup_note","label":"Message shown until a booking URL is added","default":"Add your Calendly link in this section’s settings to show the booking calendar."},
    {"type":"color_scheme","id":"color_scheme","label":"Color scheme","default":"scheme-2"}
  ],
  "presets":[{"name":"Style session booking"}]
}
{% endschema %}
