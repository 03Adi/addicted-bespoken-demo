<section class="ab-section ab-steps color-{{ section.settings.color_scheme }}">
  <div class="page-width">
    <div class="ab-section__intro">
      {%- if section.settings.eyebrow != blank -%}<p class="ab-eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
      {%- if section.settings.heading != blank -%}<h2 class="ab-section__heading">{{ section.settings.heading | escape }}</h2>{%- endif -%}
      {%- if section.settings.intro != blank -%}<div class="rte">{{ section.settings.intro }}</div>{%- endif -%}
    </div>
    {%- if section.blocks.size > 0 -%}
      <ol class="ab-steps__grid" role="list">
        {%- for block in section.blocks -%}
          <li class="ab-step" {{ block.shopify_attributes }}>
            {%- if block.settings.icon != blank -%}{{ block.settings.icon | image_url: width: 120 | image_tag: class: 'ab-step__icon', loading: 'lazy', alt: '' }}{%- else -%}<span class="ab-step__number" aria-hidden="true">{{ forloop.index | prepend: '0' }}</span>{%- endif -%}
            {%- if block.settings.title != blank -%}<h3>{{ block.settings.title | escape }}</h3>{%- endif -%}
            {%- if block.settings.text != blank -%}<div class="rte">{{ block.settings.text }}</div>{%- endif -%}
          </li>
        {%- endfor -%}
      </ol>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name":"How it works",
  "tag":"section",
  "class":"section-ab-steps",
  "settings":[
    {"type":"text","id":"eyebrow","label":"Eyebrow","default":"A BETTER FIT, STEP BY STEP"},
    {"type":"text","id":"heading","label":"Heading","default":"Your style session, made simple"},
    {"type":"richtext","id":"intro","label":"Intro","default":"<p>From first conversation to final fitting, your stylist guides every detail.</p>"},
    {"type":"color_scheme","id":"color_scheme","label":"Color scheme","default":"scheme-1"}
  ],
  "blocks":[{"type":"step","name":"Step","settings":[
    {"type":"image_picker","id":"icon","label":"Icon image"},
    {"type":"text","id":"title","label":"Title","default":"Tell us about your occasion"},
    {"type":"richtext","id":"text","label":"Short text","default":"<p>Share your plans, preferences, and the details that matter to you.</p>"}
  ]}],
  "max_blocks":6,
  "presets":[{"name":"How it works","blocks":[{"type":"step"},{"type":"step","settings":{"title":"Meet your stylist","text":"<p>Explore fabrics, fit, and personal details together.</p>"}},{"type":"step","settings":{"title":"Make it yours","text":"<p>Your made-to-order look is refined through the fitting process.</p>"}}]}]
}
{% endschema %}
