{%- assign show_testimonials = false -%}
{%- for block in section.blocks -%}
  {%- assign quote_text = block.settings.quote | strip_html | strip -%}
  {%- assign customer_name = block.settings.customer | strip -%}
  {%- unless quote_text == blank or quote_text contains 'Add an approved customer quote' or customer_name == blank or customer_name == 'Customer name' -%}
    {%- assign show_testimonials = true -%}
  {%- endunless -%}
{%- endfor -%}
{%- if show_testimonials or request.design_mode -%}
  <section class="ab-section ab-testimonials color-{{ section.settings.color_scheme }}">
    <div class="page-width">
      <div class="ab-section__intro">
        {%- if section.settings.eyebrow != blank -%}<p class="ab-eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
        {%- if section.settings.heading != blank -%}<h2 class="ab-section__heading">{{ section.settings.heading | escape }}</h2>{%- endif -%}
        {%- if section.settings.intro != blank -%}<div class="rte">{{ section.settings.intro }}</div>{%- endif -%}
      </div>
      {%- if show_testimonials -%}<div class="ab-testimonials__grid">
        {%- for block in section.blocks -%}
          {%- assign quote_text = block.settings.quote | strip_html | strip -%}
          {%- assign customer_name = block.settings.customer | strip -%}
          {%- unless quote_text == blank or quote_text contains 'Add an approved customer quote' or customer_name == blank or customer_name == 'Customer name' -%}
            <figure class="ab-quote" {{ block.shopify_attributes }}>
              <div class="ab-quote__stars" aria-label="{{ block.settings.rating_label | escape }}">★★★★★</div>
              <blockquote>{{ block.settings.quote }}</blockquote>
              <figcaption><strong>{{ block.settings.customer | escape }}</strong>{%- if block.settings.location != blank -%}<span>{{ block.settings.location | escape }}</span>{%- endif -%}</figcaption>
            </figure>
          {%- endunless -%}
        {%- endfor -%}
      </div>{%- elsif request.design_mode -%}<p class="ab-editor-note">Add an approved customer quote and customer name to display testimonials.</p>{%- endif -%}
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name":"Testimonials",
  "tag":"section",
  "class":"section-ab-testimonials",
  "settings":[
    {"type":"text","id":"eyebrow","label":"Eyebrow","default":"WORDS FROM OUR CLIENTS"},
    {"type":"text","id":"heading","label":"Heading","default":"A personal process, a lasting impression"},
    {"type":"richtext","id":"intro","label":"Intro","default":"<p>Add approved customer feedback below.</p>"},
    {"type":"color_scheme","id":"color_scheme","label":"Color scheme","default":"scheme-2"}
  ],
  "blocks":[{"type":"testimonial","name":"Testimonial","settings":[
    {"type":"richtext","id":"quote","label":"Quote","default":"<p>Add an approved customer quote.</p>"},
    {"type":"text","id":"customer","label":"Customer name","default":"Customer name"},
    {"type":"text","id":"location","label":"Location","default":"Location"},
    {"type":"text","id":"rating_label","label":"Rating accessibility label","default":"Five out of five stars"}
  ]}],
  "max_blocks":6,
  "presets":[{"name":"Testimonials"}]
}
{% endschema %}
